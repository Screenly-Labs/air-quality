{
  "name": "screenly-air-quality-app",
  "private": true,
  "version": "0.0.1",
  "main": "src/index.tsx",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "sync-fonts": "bun run sync-fonts.ts",
    "dev": "bun run build.ts --client && wrangler dev",
    "build": "bun run build.ts",
    "deploy": "bun run build && wrangler deploy --env=dev"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@screenly-labs/signage-kit": "github:Screenly-Labs/signage-kit#2026.8.11",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@cloudflare/workers-types": "^5.20260821.1",
    "browserslist": "^4.28.8",
    "bun-types": "^1.4.0",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
